{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dotDiagram","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"codeListing","code":["dot -Tsvg order.dot -o order.svg"],"syntax":null},{"inlineContent":[{"type":"text","text":"Every state is a node, named by its description. The states connected"},{"type":"text","text":" "},{"type":"text","text":"by transitions are connected by an arrow, labeled with the events. If"},{"type":"text","text":" "},{"type":"text","text":"several events lead from a state to the same state, they share one"},{"type":"text","text":" "},{"type":"text","text":"arrow. The initial state has an arrow leading to it from a point, and"},{"type":"text","text":" "},{"type":"text","text":"the ending states are drawn with a double outline."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The diagram is the same every time, whatever order the transitions were"},{"type":"text","text":" "},{"type":"text","text":"given in, so it can be compared with a saved diagram. This needs the"},{"type":"text","text":" "},{"type":"text","text":"states to have different descriptions. States with the same description"},{"type":"text","text":" "},{"type":"text","text":"are still different nodes, told apart by a number added to their names,"},{"type":"text","text":" "},{"type":"text","text":"but which of the states that gets which number can differ."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":"), where "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" is the number of transitions."}]}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine\/dotDiagram"},"sections":[],"hierarchy":{"paths":[["doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams","doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine","doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine"]]},"metadata":{"role":"symbol","title":"dotDiagram","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dotDiagram","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"extendedModule":"MiamiStateMachine","externalID":"s:17MiamiStateMachine0bC0C0A8DiagramsE10dotDiagramSSvp","roleHeading":"Instance Property","modules":[{"name":"MiamiDiagrams","relatedModules":["MiamiStateMachine"]}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Event"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"StateMachineEvent"},{"type":"text","text":", "},{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Context"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]}},"abstract":[{"text":"The definition of the state machine as a diagram, in the DOT language","type":"text"},{"text":" ","type":"text"},{"text":"of Graphviz. Save it to a file, and Graphviz draws the diagram:","type":"text"}],"variants":[{"paths":["\/documentation\/miamidiagrams\/miamistatemachine\/statemachine\/dotdiagram"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://MiamiDiagrams/documentation/MiamiDiagrams/MiamiStateMachine/StateMachine":{"role":"symbol","kind":"symbol","title":"StateMachine","fragments":[{"text":"extension","kind":"keyword"},{"text":" ","kind":"text"},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C","text":"StateMachine","kind":"identifier"}],"navigatorTitle":[{"text":"StateMachine","kind":"identifier"}],"url":"\/documentation\/miamidiagrams\/miamistatemachine\/statemachine","identifier":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine","abstract":[],"type":"topic"},"doc://MiamiDiagrams/documentation/MiamiDiagrams/MiamiStateMachine":{"role":"collection","kind":"symbol","title":"MiamiStateMachine","url":"\/documentation\/miamidiagrams\/miamistatemachine","identifier":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine","abstract":[],"type":"topic"},"doc://MiamiDiagrams/documentation/MiamiDiagrams":{"role":"collection","kind":"symbol","title":"MiamiDiagrams","url":"\/documentation\/miamidiagrams","identifier":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams","abstract":[],"type":"topic"},"doc://MiamiDiagrams/documentation/MiamiDiagrams/MiamiStateMachine/StateMachine/dotDiagram":{"role":"symbol","kind":"symbol","title":"dotDiagram","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"dotDiagram","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"}],"url":"\/documentation\/miamidiagrams\/miamistatemachine\/statemachine\/dotdiagram","identifier"