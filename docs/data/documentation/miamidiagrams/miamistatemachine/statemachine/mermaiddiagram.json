ext":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every state is declared with its description, and with an identifier"},{"type":"text","text":" "},{"type":"text","text":"made up from its position among the states, like "},{"code":"state1","type":"codeVoice"},{"type":"text","text":". A description"},{"type":"text","text":" "},{"type":"text","text":"can be any text, which an identifier in Mermaid cannot. The states"},{"type":"text","text":" "},{"type":"text","text":"connected by transitions are connected by an arrow, labeled with the"},{"type":"text","text":" "},{"type":"text","text":"events. If several events lead from a state to the same state, they"},{"type":"text","text":" "},{"type":"text","text":"share one arrow. The initial state has an arrow leading to it from the"},{"type":"text","text":" "},{"type":"text","text":"start, written "},{"code":"[*]","type":"codeVoice"},{"type":"text","text":", and every ending state has an arrow to the end."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The diagram is the same every time, whatever order the transitions were"},{"type":"text","text":" "},{"type":"text","text":"given in, so it can be compared with a saved diagram. This needs the"},{"text":" ","type":"text"},{"text":"states to have different descriptions. States with the same description","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"are still different states in the diagram, but which of them that gets"},{"type":"text","text":" "},{"type":"text","text":"which identifier can differ."}]},{"content":[{"inlineContent":[{"type":"text","text":"O("},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" log "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":"), where "},{"type":"emphasis","inlineContent":[{"type":"text","text":"n"}]},{"type":"text","text":" is the number of transitions."}],"type":"paragraph"}],"name":"Complexity","style":"note","type":"aside"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"The definition of the state machine as a diagram, in the language of","type":"text"},{"text":" ","type":"text"},{"text":"Mermaid. It is drawn where Mermaid is, like in Markdown on GitHub, when","type":"text"},{"text":" ","type":"text"},{"text":"put in a code block marked ","type":"text"},{"code":"mermaid","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","references":{"doc://MiamiDiagrams/documentation/MiamiDiagrams/MiamiStateMachine/StateMachine":{"type":"topic","kind":"symbol","abstract":[],"navigatorTitle":[{"kind":"identifier","text":"StateMachine"}],"url":"\/documentation\/miamidiagrams\/miamistatemachine\/statemachine","role":"symbol","fragments":[{"kind":"keyword","text":"extension"},{"kind":"text","text":" "},{"kind":"identifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C","text":"StateMachine"}],"title":"StateMachine","identifier":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine"},"doc://MiamiDiagrams/documentation/MiamiDiagrams/MiamiStateMachine/StateMachine/mermaidDiagram":{"identifier":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine\/mermaidDiagram","abstract":[{"type":"text","text":"The definition of the state machine as a diagram, in the language of"},{"type":"text","text":" "},{"type":"text","text":"Mermaid. It is drawn where Mermaid is, like in Markdown on GitHub, when"},{"type":"text","text":" "},{"type":"text","text":"put in a code block marked "},{"type":"codeVoice","code":"mermaid"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefi