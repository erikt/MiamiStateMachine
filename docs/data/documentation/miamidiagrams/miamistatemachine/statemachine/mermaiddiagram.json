{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"nonisolated","kind":"attribute"},{"text":" ","kind":"text"},{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mermaidDiagram","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:SS","text":"String","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Every state is declared with its description, and with an identifier"},{"type":"text","text":" "},{"type":"text","text":"made up from its position among the states, like "},{"type":"codeVoice","code":"state1"},{"type":"text","text":". A description"},{"type":"text","text":" "},{"type":"text","text":"can be any text, which an identifier in Mermaid cannot. The states"},{"type":"text","text":" "},{"type":"text","text":"connected by transitions are connected by an arrow, labeled with the"},{"type":"text","text":" "},{"type":"text","text":"events. If several events lead from a state to the same state, they"},{"type":"text","text":" "},{"type":"text","text":"share one arrow. The initial state has an arrow leading to it from the"},{"type":"text","text":" "},{"type":"text","text":"start, written "},{"type":"codeVoice","code":"[*]"},{"type":"text","text":", and every ending state has an arrow to the end."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The diagram is the same every time, whatever order the transitions were"},{"type":"text","text":" "},{"type":"text","text":"given in, so it can be compared with a saved diagram. This needs the"},{"type":"text","text":" "},{"type":"text","text":"states to have different descriptions. States with the same description"},{"type":"text","text":" "},{"type":"text","text":"are still different states in the diagram, but which of them that gets"},{"type":"text","text":" "},{"type":"text","text":"which identifier can differ."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"O("},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" log "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":"), where "},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"type":"text","text":" is the number of transitions."}]}],"name":"Complexity","type":"aside","style":"note"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine\/mermaidDiagram"},"sections":[],"hierarchy":{"paths":[["doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams","doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine","doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine"]]},"metadata":{"role":"symbol","title":"mermaidDiagram","symbolKind":"property","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mermaidDiagram","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","preciseIdentifier":"s:SS","kind":"typeIdentifier"}],"extendedModule":"MiamiStateMachine","externalID":"s:17MiamiStateMachine0bC0C0A8DiagramsE14mermaidDiagramSSvp","roleHeading":"Instance Property","modules":[{"name":"MiamiDiagrams","relatedModules":["MiamiStateMachine"]}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"Event"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"StateMachineEvent"},{"type":"text","text":", "},{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", "},{"type":"codeVoice","code":"State"},