,"kind":"keyword"},{"text":" ","kind":"text"},{"text":"mermaidDiagram","kind":"identifier"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Every state is declared with its description, and with an identifier","type":"text"},{"text":" ","type":"text"},{"text":"made up from its position among the states, like ","type":"text"},{"code":"state1","type":"codeVoice"},{"text":". A description","type":"text"},{"text":" ","type":"text"},{"text":"can be any text, which an identifier in Mermaid cannot. The states","type":"text"},{"text":" ","type":"text"},{"text":"connected by transitions are connected by an arrow, labeled with the","type":"text"},{"text":" ","type":"text"},{"text":"events. If several events lead from a state to the same state, they","type":"text"},{"text":" ","type":"text"},{"text":"share one arrow. The initial state has an arrow leading to it from the","type":"text"},{"text":" ","type":"text"},{"text":"start, written ","type":"text"},{"code":"[*]","type":"codeVoice"},{"text":", and every ending state has an arrow to the end.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The diagram is the same every time, whatever order the transitions were","type":"text"},{"text":" ","type":"text"},{"text":"given in, so it can be compared with a saved diagram. This needs the","type":"text"},{"text":" ","type":"text"},{"text":"states to have different descriptions. States with the same description","type":"text"},{"text":" ","type":"text"},{"text":"are still different states in the diagram, but which of them that gets","type":"text"},{"text":" ","type":"text"},{"text":"which identifier can differ.","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"text":"O(","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" log ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":"), where ","type":"text"},{"inlineContent":[{"type":"text","text":"n"}],"type":"emphasis"},{"text":" is the number of transitions.","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Complexity"}]}],"hierarchy":{"paths":[["doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams","doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine","doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine"]]},"references":{"doc://MiamiDiagrams/documentation/MiamiDiagrams/MiamiStateMachine/StateMachine/mermaidDiagram":{"abstract":[{"text":"The definition of the state machine as a diagram, in the language of","type":"text"},{"text":" ","type":"text"},{"text":"Mermaid. It is drawn where Mermaid is, like in Markdown on GitHub, when","type":"text"},{"text":" ","type":"text"},{"text":"put in a code block marked ","type":"text"},{"type":"codeVoice","code":"mermaid"},{"text":".","type":"text"}],"url":"\/documentation\/miamidiagrams\/miamistatemachine\/statemachine\/mermaiddiagram","kind":"symbol","identifier":"doc:\/\/MiamiDiagrams\/documentation\/MiamiDiagrams\/MiamiStateMachine\/StateMachine\/mermaidDiagram","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"mermaidDiagram"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"}],"conformance":{"constraints":[{"type":"codeVoice","code":"Event"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"StateMachineEvent"},{"text":", ","type":"text"},{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"State"},{"