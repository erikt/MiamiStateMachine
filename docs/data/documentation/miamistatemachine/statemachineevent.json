,"text":"transition: a transition for "},{"type":"codeVoice","code":"finish(bytes: 0)"},{"type":"text","text":" is not one for"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish(bytes: 512)"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["enum LoadEvent: StateMachineEvent {","    case start","    case finish(bytes: Int)","    case fail(reason: String)","","    enum EventTrigger {","        case start, finish, fail","    }","","    var eventTrigger: EventTrigger {","        switch self {","        case .start: .start","        case .finish: .finish","        case .fail: .fail","        }","    }","}"],"type":"codeListing","syntax":null}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"identifiers":["doc:\/\/MiamiStateMachine\/s8SendableP","doc:\/\/MiamiStateMachine\/s16SendableMetatypeP"],"type":"inheritsFrom","kind":"relationships","title":"Inherits From"},{"identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/Swift\/Int","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/Swift\/String"],"type":"conformingTypes","kind":"relationships","title":"Conforming Types"}],"abstract":[{"type":"text","text":"An event of a state machine. It tells what happened, and can carry"},{"type":"text","text":" "},{"type":"text","text":"what it happened with, like the data loaded or the reason for a failure."}],"topicSections":[{"identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachineEvent\/EventTrigger-swift.associatedtype"],"title":"Associated Types","generated":true,"anchor":"Associated-Types"},{"identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachineEvent\/eventTrigger-2tmg8"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MiamiS