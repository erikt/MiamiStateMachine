ot one for","type":"text"},{"type":"text","text":" "},{"code":"finish(bytes: 512)","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["enum LoadEvent: StateMachineEvent {","    case start","    case finish(bytes: Int)","    case fail(reason: String)","","    enum EventTrigger {","        case start, finish, fail","    }","","    var eventTrigger: EventTrigger {","        switch self {","        case .start: .start","        case .finish: .finish","        case .fail: .fail","        }","    }","}"],"syntax":null,"type":"codeListing"}]}],"topicSections":[{"title":"Associated Types","generated":true,"anchor":"Associated-Types","identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachineEvent\/EventTrigger-swift.associatedtype"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachineEvent\/eventTrigger-2tmg8"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachineevent"]}],"relationshipsSections":[{"title":"Inherits From","type":"inheritsFrom","kind":"relationships","identifiers":["doc:\/\/MiamiStateMachine\/s8SendableP","doc:\/\/MiamiStateMachine\/s16SendableMetatypeP"]},{"title":"Conforming Types","type":"conformingTypes","kind":"relationships","identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/Swift\/Int","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/Swift\/String"]}],"metadata":{"title":"StateMachineEvent","modules":[{"name":"MiamiStateMachine"}],"navigatorTitle":[{"kind":"identifier","text":"StateMachineEvent"}],"symbolKind":"protocol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"StateMachineEvent"}],"role":