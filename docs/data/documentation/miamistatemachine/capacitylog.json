paragraph","inlineContent":[{"type":"text","text":"The log is a collection of its elements, from the oldest to the"},{"type":"text","text":" "},{"type":"text","text":"newest. It can be iterated, and the elements can be accessed by"},{"type":"text","text":" "},{"type":"text","text":"their position, where the oldest element is at position zero."}]},{"type":"codeListing","syntax":null,"code":["for transition in log {","    print(transition)","}","","let oldest = log.first","let secondNewest = log[log.count - 2]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The log can be encoded when its elements can, and decoded when they"},{"type":"text","text":" "},{"type":"text","text":"can be decoded. It is saved with its max capacity, so a decoded log"},{"type":"text","text":" "},{"type":"text","text":"goes on dropping its oldest elements like the log encoded. The keys"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":", left out for a log without max capacity, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"elements"},{"type":"text","text":", with the elements from the oldest to the newest."}]},{"inlineContent":[{"text":"The log is implemented with the Apple Swift Collection","type":"text"},{"text":" ","type":"text"},{"text":"deque and should be performant.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/CapacityLog\/init(capacity:)"]},{"title":"Instance Properties","generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/CapacityLog\/count","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/CapacityLog\/first","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/CapacityLog\/isEmpt