{"abstract":[{"type":"text","text":"Creates a stream of the transitions made from now on, in the"},{"type":"text","text":" "},{"type":"text","text":"order they are made."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/transitionStream(bufferingPolicy:)"},"kind":"symbol","metadata":{"roleHeading":"Instance Method","symbolKind":"method","title":"transitionStream(bufferingPolicy:)","role":"symbol","externalID":"s:17MiamiStateMachine0bC0C16transitionStream15bufferingPolicyScSyAA15TransitionEventVyxq_GGScS12ContinuationV09BufferingG0OyAH__G_tF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionStream"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bufferingPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama","text":"TransitionStream"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO","text":"BufferingPolicy"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama","text":"TransitionStream"}],"modules":[{"name":"MiamiStateMachine"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionStream"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bufferingPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/TransitionStream","preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama","text":"TransitionStream"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO","text":"BufferingPolicy"},{"kind":"text","text":" = .unbounded) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/TransitionStream","preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama","text":"TransitionStream"}]}]},{"kind":"parameters","parameters":[{"name":"bufferingPolicy","content":[{"inlineContent":[{"text":"How transitions are buffered until they","type":"text"},{"text":" ","type":"text"},{"text":"are consumed. By default all of them, without any limit.","type":"text"}],"type":"paragraph"}]}]},{"kind":"content","content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A new stream of transitions."}]}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every call creates a new stream, independent of all other streams."},{"type":"text","text":" "},{"type":"text","text":"Several consumers can each have a stream of their own, and all of"},{"type":"text","text":" "},{"type":"text","text":"them get every transition. Cancelling the task of a consumer, or"},{"type":"text","text":" "},{"type":"text","text":"letting go of a stream, ends only that stream."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stream finishes when the state machine reaches an ending state,"},{"type":"text","text":" "},{"type":"text","text":"after the transition leading there, as no further transitions will"},{"type":"text","text":" "},{"type":"text","text":"be made. A stream created at an ending state is finished from the"},{"type":"text","text":" "},{"type":"text","text":"start. The stream also finishes if the state machine is deallocated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create the stream before processing the events of interest, and"},{"type":"text","text":" "},{"type":"text","text":"hand it over to the task consuming it. A stream created by a new"},{"type":"text","text":" "},{"type":"text","text":"task misses the transitions made before the task starts running."}]},{"code":["let transitions = await stateMachine.transitionStream()","","Task {","    for await transition in transitions {","        print(transition)","    }","}"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the transition received, and not "},{"type":"codeVoice","code":"state"},{"type":"text","text":", to know the state"},{"type":"text","text":" "},{"type":"text","text":"entered. The state machine may have moved on since the transition."}]}]}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/transitionstream(bufferingpolicy:)"]}],"references":{"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachine/TransitionStream":{"navigatorTitle":[{"text":"TransitionStream","kind":"identifier"}],"type":"topic","url":"\/documentation\/miamistatemachine\/statemachine\/transitionstream","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TransitionStream","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"A stream of the transitions made by a state machine.","type":"text"}],"title":"StateMachine.TransitionStream","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/TransitionStream","role":"symbol"},"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachine":{"abstract":[{"text":"A state machine is an actor with a current state and","type":"text"},{"text":" ","type":"text"},{"text":"a set of transitions defining the machine. The ","type":"text"},{"code":"TransitionRule","type":"codeVoice"},{"text":" ","type":"text"},{"text":"connects two states by an event trigger.","type":"text"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"StateMachine"}],"type":"topic","title":"StateMachine","url":"\/documentation\/miamistatemachine\/statemachine","navigatorTitle":[{"kind":"identifier","text":"StateMachine"}],"identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine","kind":"symbol","role":"symbol"},"doc://MiamiStateMachine/documentation/MiamiStateMachine":{"kind":"symbol","role":"collection","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine","abstract":[],"type":"topic","url":"\/documentation\/miamistatemachine","title":"MiamiStateMachine"},"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachine/transitionStream(bufferingPolicy:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"transitionStream"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bufferingPolicy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"TransitionStream","preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Continuation","preciseIdentifier":"s:ScS12ContinuationV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"BufferingPolicy","preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"TransitionStream","preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Creates a stream of the transitions made from now on, in the"},{"type":"text","text":" "},{"type":"text","text":"order they are made."}],"role":"symbol","url":"\/documentation\/miamistatemachine\/statemachine\/transitionstream(bufferingpolicy:)","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/transitionStream(bufferingPolicy:)","title":"transitionStream(bufferingPolicy:)"}}}