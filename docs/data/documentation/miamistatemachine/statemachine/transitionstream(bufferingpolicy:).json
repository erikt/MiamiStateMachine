t","text":" "},{"type":"text","text":"start. The stream also finishes if the state machine is deallocated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create the stream before processing the events of interest, and"},{"type":"text","text":" "},{"type":"text","text":"hand it over to the task consuming it. A stream created by a new"},{"type":"text","text":" "},{"type":"text","text":"task misses the transitions made before the task starts running."}]},{"syntax":null,"type":"codeListing","code":["let transitions = await stateMachine.transitionStream()","","Task {","    for await transition in transitions {","        print(transition)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the transition received, and not "},{"code":"state","type":"codeVoice"},{"type":"text","text":", to know the state"},{"type":"text","text":" "},{"type":"text","text":"entered. The state machine may have moved on since the transition."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/transitionstream(bufferingpolicy:)"]}],"abstract":[{"type":"text","text":"Creates a stream of the transitions made from now on, in the"},{"type":"text","text":" "},{"type":"text","text":"order they are made."}],"references":{"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachine":{"role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"StateMachine"}],"type":"topic","title":"StateMachine","url":"\/documentation\/miamistatemachine\/statemachine","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"StateMachine"}],"identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine","abstract":[{"type":"text","text":"A state machine is an actor with a current state and"},{"type":"text","text":" "},{"text":"a set of transitions defining the machine. The ","type":"text"},{"code":"TransitionRule