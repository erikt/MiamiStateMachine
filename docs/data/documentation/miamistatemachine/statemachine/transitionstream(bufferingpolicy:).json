{"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"transitionStream","kind":"identifier"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"bufferingPolicy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama","kind":"typeIdentifier","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/TransitionStream","text":"TransitionStream"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ScS12ContinuationV","kind":"typeIdentifier","text":"Continuation"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO","kind":"typeIdentifier","text":"BufferingPolicy"},{"kind":"text","text":" = .unbounded) -> "},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C16TransitionStreama","kind":"typeIdentifier","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/TransitionStream","text":"TransitionStream"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How transitions are buffered until they"},{"type":"text","text":" "},{"type":"text","text":"are consumed. By default all of them, without any limit."}]}],"name":"bufferingPolicy"}],"kind":"parameters"},{"content":[{"level":2,"anchor":"return-value","text":"Return Value","type":"heading"},{"inlineContent":[{"type":"text","text":"A new stream of transitions."}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"Every call creates a new stream, independent of all other streams.","type":"text"},{"text":" ","type":"text"},{"text":"Several consumers can each have a stream of their own, and all of","type":"text"},{"text":" ","type":"text"},{"text":"them get every transition. Cancelling the task of a consumer, or","type":"text"},{"text":" ","type":"text"},{"text":"letting go of a stream, ends only that stream.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The stream finishes when the state machine reaches an ending state,","type":"text"},{"text":" ","type":"text"},{"text":"after the transition leading there, as no further transitions will","type":"text"},{"text":" ","type":"text"},{"text":"be made. A stream created at an ending state is finished from the","type":"text"},{"text":" ","type":"text"},{"text":"start. The stream also finishes if the state machine is deallocated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Create the stream before processing the events of interest, and"},{"type":"text","text":" "},{"type":"text","text":"hand it over to the task consuming it. A stream created by a new"},{"type":"text","text":" "},{"type":"text","text":"task misses the transitions made before the task starts running."}],"type":"paragraph"},{"code":["let transitions = await stateMachine.transitionStream()","","Task {","    for await transition in transitions {","        print(transition)","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use the transition received, and not "},{"type":"codeVoice","code":"state"},{"type":"text","text":", to know the state"},{"type":"text","text":" "},{"type":"text","text":"entered. The state machine may have moved on since the transition."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/transitionstream(bufferingpolicy:)"]}],"sections":[],"metadata":{"roleHeading":"Instance Method","title":"transitionStream(bufferingPolicy:)","externalID":