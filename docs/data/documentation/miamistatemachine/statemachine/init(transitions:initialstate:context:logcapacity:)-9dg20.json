neContent":[{"type":"text","text":"The transitions are written in event triggers, which does not tell the"},{"type":"text","text":" "},{"type":"text","text":"type of the events, so it has to be written: "},{"type":"codeVoice","code":"StateMachine<LoadEvent, LoadState, Progress>(transitions:initialState:context:)"},{"type":"text","text":". It is known"},{"type":"text","text":" "},{"type":"text","text":"from the transitions only for events being their own trigger."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Transitions given as a set have no actions, so the context stays as it"},{"type":"text","text":" "},{"type":"text","text":"is given. Actions are written with the rule builder."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"code":"DefinitionError","type":"codeVoice"},{"type":"text","text":" with the transitions in conflict, if two"},{"type":"text","text":" "},{"type":"text","text":"or more transitions lead from the same state, for the same event,"},{"type":"text","text":" "},{"type":"text","text":"to different states."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Throws"}]}],"hierarchy":{"paths":[["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Creates a new state machine, with a context."}],"identifier":{"url":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/init(transitions:initialState:context:logCapacity:)-9dg20","interfaceLanguage":"swift"},"metadata":{"title":"init(transitions:initialState:context:logCapacity:)","symbolKind":"init","fragments":[{"text":"convenience","kind":"keyword"},{"text":" ","kind":"text"},{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"transitions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdenti