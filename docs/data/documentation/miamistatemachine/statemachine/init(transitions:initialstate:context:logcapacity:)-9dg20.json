{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/init(transitions:initialstate:context:logcapacity:)-9dg20"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"convenience"},{"kind":"text","text":" "},{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"transitions"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/TransitionRule","preciseIdentifier":"s:17MiamiStateMachine14TransitionRuleV","text":"TransitionRule"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C5Eventxmfp","text":"Event"},{"kind":"text","text":"."},{"kind":"typeIdentifier","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachineEvent\/EventTrigger-swift.associatedtype","text":"EventTrigger","preciseIdentifier":"s:17MiamiStateMachine0bC5EventP0D7TriggerQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B0q_mfp","text":"State"},{"kind":"text","text":">>, "},{"kind":"externalParam","text":"initialState"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B0q_mfp","text":"State"},{"kind":"text","text":", "},{"kind":"externalParam","text":"context"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C7Contextq0_mfp","text":"Context"},{"kind":"text","text":", "},{"kind":"externalParam","text":"logCapacity"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"UInt","preciseIdentifier":"s:Su"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":"("},{"kind":"typeIdentifier","identifier":"