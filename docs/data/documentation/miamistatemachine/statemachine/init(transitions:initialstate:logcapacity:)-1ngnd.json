:"text"},{"text":" ","type":"text"},{"text":"only for events being their own trigger.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Throws","content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"DefinitionError","type":"codeVoice"},{"type":"text","text":" with the transitions in conflict, if two"},{"text":" ","type":"text"},{"text":"or more transitions lead from the same state, for the same event,","type":"text"},{"type":"text","text":" "},{"text":"to different states.","type":"text"}],"type":"paragraph"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/init(transitions:initialState:logCapacity:)-1ngnd","interfaceLanguage":"swift"},"references":{"doc://MiamiStateMachine/documentation/MiamiStateMachine/TransitionRule":{"abstract":[{"text":"A rule of the definition of a state machine: the transition from a state,","type":"text"},{"text":" ","type":"text"},{"text":"for an event, to another state. A rule only leads in one direction.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/TransitionRule","title":"TransitionRule","navigatorTitle":[{"kind":"identifier","text":"TransitionRule"}],"role":"symbol","url":"\/documentation\/miamistatemachine\/transitionrule","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"TransitionRule","kind":"identifier"}],"type":"topic"},"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachineEvent/EventTrigger-swift.associatedtype":{"role":"symbol","type":"topic","url":"\/documentation\/miamistatemachine\/statemachineevent\/eventtrigger-swift.associatedtype","title":"EventTrigger","kind":"symbol","abstract":[{"text":"What the definition of a state machine is written in. It is the","type":"text"},{"text":" ","type":"text"},{"text":"event itself, unless the event declares another.","type":"text"}],"require