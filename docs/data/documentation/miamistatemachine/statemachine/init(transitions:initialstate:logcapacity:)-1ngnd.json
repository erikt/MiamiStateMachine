e:)"},{"type":"text","text":". It is known from the transitions"},{"type":"text","text":" "},{"type":"text","text":"only for events being their own trigger."}]},{"type":"aside","name":"Throws","style":"note","content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"DefinitionError"},{"type":"text","text":" with the transitions in conflict, if two"},{"type":"text","text":" "},{"type":"text","text":"or more transitions lead from the same state, for the same event,"},{"text":" ","type":"text"},{"type":"text","text":"to different states."}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/init(transitions:initialstate:logcapacity:)-1ngnd"]}],"identifier":{"url":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/init(transitions:initialState:logCapacity:)-1ngnd","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"metadata":{"fragments":[{"kind":"keyword","text":"convenience"},{"text":" ","kind":"text"},{"kind":"identifier","text":"init"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"transitions"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine14TransitionRuleV","text":"TransitionRule"},{"text":"<","kind":"text"},{"text":"Event","preciseIdentifier":"s:17MiamiStateMachine0bC0C5Eventxmfp","kind":"typeIdentifier"},{"kind":"text","text":"."},{"text":"EventTrigger","preciseIdentifier":"s:17MiamiStateMachine0bC5EventP0D7TriggerQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"State","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B0q_mfp","kind":"typeIdentifier"},{"text":">>, ","kind":"text"},{"kind":"externalParam","text":"initialState"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:17M