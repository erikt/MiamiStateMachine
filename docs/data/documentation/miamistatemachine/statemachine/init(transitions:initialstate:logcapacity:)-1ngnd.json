 "},{"type":"text","text":"only for events being their own trigger."}],"type":"paragraph"},{"style":"note","type":"aside","name":"Throws","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"DefinitionError","type":"codeVoice"},{"type":"text","text":" with the transitions in conflict, if two"},{"type":"text","text":" "},{"type":"text","text":"or more transitions lead from the same state, for the same event,"},{"type":"text","text":" "},{"type":"text","text":"to different states."}]}]}],"kind":"content"}],"metadata":{"roleHeading":"Initializer","title":"init(transitions:initialState:logCapacity:)","externalID":"s:17MiamiStateMachine0bC0C11transitions07initialB011logCapacityACyxq_GShyAA14TransitionRuleVy12EventTriggerQzq_GG_q_SuSgtAC15DefinitionErrorVyxq__GYKcfc","symbolKind":"init","modules":[{"name":"MiamiStateMachine"}],"role":"symbol","fragments":[{"text":"convenience","kind":"keyword"},{"text":" ","kind":"text"},{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"transitions","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"TransitionRule","preciseIdentifier":"s:17MiamiStateMachine14TransitionRuleV","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Event","preciseIdentifier":"s:17MiamiStateMachine0bC0C5Eventxmfp","kind":"typeIdentifier"},{"text":".","kind":"text"},{"text":"EventTrigger","preciseIdentifier":"s:17MiamiStateMachine0bC5EventP0D7TriggerQa","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"State","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B0q_mfp","kind":"typeIdentifier"},{"text":">>, ","kind":"text"},{"text":"initialState","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"State","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B0q_mfp","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"logCapacity","kind":"externalParam"},{"text":": ","kind":"text"}