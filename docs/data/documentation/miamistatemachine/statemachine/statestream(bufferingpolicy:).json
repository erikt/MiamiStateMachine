{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"symbolKind":"method","title":"stateStream(bufferingPolicy:)","externalID":"s:17MiamiStateMachine0bC0C11stateStream15bufferingPolicyScSyq_GScS12ContinuationV09BufferingG0Oyq___G_tF","modules":[{"name":"MiamiStateMachine"}],"roleHeading":"Instance Method","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stateStream","kind":"identifier"},{"text":"(","kind":"text"},{"text":"bufferingPolicy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","text":"StateStream","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ScS12ContinuationV","text":"Continuation","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO","text":"BufferingPolicy","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","text":"StateStream","kind":"typeIdentifier"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/statestream(bufferingpolicy:)"]}],"sections":[],"kind":"symbol","abstract":[{"text":"Creates a stream of the states the state machine is at. It starts","type":"text"},{"text":" ","type":"text"},{"text":"with the current state, followed by the state entered by every","type":"text"},{"text":" ","type":"text"},{"text":"transition made from now on, in the order they are made.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stateStream","kind":"identifier"},{"text":"(","kind":"text"},{"text":"bufferingPolicy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","text":"StateStream","kind":"typeIdentifier","identifier":"doc:\/\/MiamiStateMachine\/documenta