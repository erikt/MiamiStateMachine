{"identifier":{"url":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/stateStream(bufferingPolicy:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Creates a stream of the states the state machine is at. It starts","type":"text"},{"text":" ","type":"text"},{"text":"with the current state, followed by the state entered by every","type":"text"},{"text":" ","type":"text"},{"text":"transition made from now on, in the order they are made.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stateStream"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bufferingPolicy"},{"kind":"text","text":": "},{"identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/StateStream","kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","text":"StateStream"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Continuation","preciseIdentifier":"s:ScS12ContinuationV"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"BufferingPolicy","preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO"},{"kind":"text","text":" = .unbounded) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","text":"StateStream","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/StateStream"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"How states are buffered until they are"},{"type":"text","text":" "},{"type":"text","text":"consumed. By default all of them, without any limit. A consumer only"},{"type":"text","text":" "},{"type":"text","text":"interested in where the state machine is now, and not in the states"},{"type":"text","text":" "},{"type":"text","text":"it passed on the way, can use "},{"type":"codeVoice","code":".bufferingNewest(1)"},{"text":".","type":"text"}]}],"name":"bufferingPolicy"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"type":"paragraph","inlineContent":[{"text":"A new stream of states, starting with the current state.","type":"text"}]}],"kind":"content"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current state is delivered at once, so a stream tells where the"},{"type":"text","text":" "},{"type":"text","text":"state machine is whenever it is created. This makes it a good fit for"},{"type":"text","text":" "},{"type":"text","text":"a user interface. To know how a state was entered, or to not miss any"},{"type":"text","text":" "},{"type":"text","text":"transition, use "},{"type":"codeVoice","code":"transitionStream"},{"type":"text","text":" instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A transition leading back to the same state delivers the state again."},{"type":"text","text":" "},{"type":"text","text":"A rejected event delivers nothing, as the state machine stays where it is."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every call creates a new stream, independent of all other streams."},{"type":"text","text":" "},{"type":"text","text":"Several consumers can each have a stream of their own, and all of"},{"type":"text","text":" "},{"type":"text","text":"them get every state. Cancelling the task of a consumer, or"},{"type":"text","text":" "},{"type":"text","text":"letting go of a stream, ends only that stream."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The stream finishes when the state machine reaches an ending state,"},{"type":"text","text":" "},{"type":"text","text":"after delivering that state. A stream created at an ending state"},{"type":"text","text":" "},{"type":"text","text":"delivers the state and finishes. The stream also finishes if the"},{"type":"text","text":" "},{"type":"text","text":"state machine is deallocated."}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine"]]},"metadata":{"symbolKind":"method","role":"symbol","modules":[{"name":"MiamiStateMachine"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stateStream"},{"kind":"text","text":"("},{"kind":"externalParam","text":"bufferingPolicy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","kind":"typeIdentifier","text":"StateStream"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ScS12ContinuationV","kind":"typeIdentifier","text":"Continuation"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO","kind":"typeIdentifier","text":"BufferingPolicy"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","kind":"typeIdentifier","text":"StateStream"}],"externalID":"s:17MiamiStateMachine0bC0C11stateStream15bufferingPolicyScSyq_GScS12ContinuationV09BufferingG0Oyq___G_tF","roleHeading":"Instance Method","title":"stateStream(bufferingPolicy:)"},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/statestream(bufferingpolicy:)"]}],"references":{"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachine/stateStream(bufferingPolicy:)":{"url":"\/documentation\/miamistatemachine\/statemachine\/statestream(bufferingpolicy:)","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/stateStream(bufferingPolicy:)","title":"stateStream(bufferingPolicy:)","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"stateStream"},{"kind":"text","text":"("},{"text":"bufferingPolicy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"StateStream","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:ScS12ContinuationV","kind":"typeIdentifier","text":"Continuation"},{"kind":"text","text":"."},{"preciseIdentifier":"s:ScS12ContinuationV15BufferingPolicyO","kind":"typeIdentifier","text":"BufferingPolicy"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:17MiamiStateMachine0bC0C0B6Streama","kind":"typeIdentifier","text":"StateStream"}],"abstract":[{"type":"text","text":"Creates a stream of the states the state machine is at. It starts"},{"type":"text","text":" "},{"type":"text","text":"with the current state, followed by the state entered by every"},{"type":"text","text":" "},{"type":"text","text":"transition made from now on, in the order they are made."}]},"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachine":{"abstract":[{"type":"text","text":"A state machine is an actor with a current state and"},{"text":" ","type":"text"},{"type":"text","text":"a set of transitions defining the machine. The "},{"code":"TransitionRule","type":"codeVoice"},{"text":" ","type":"text"},{"text":"connects two states by an event trigger.","type":"text"}],"kind":"symbol","title":"StateMachine","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine","navigatorTitle":[{"text":"StateMachine","kind":"identifier"}],"role":"symbol","url":"\/documentation\/miamistatemachine\/statemachine","fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"text":"StateMachine","kind":"identifier"}],"type":"topic"},"doc://MiamiStateMachine/documentation/MiamiStateMachine/StateMachine/StateStream":{"url":"\/documentation\/miamistatemachine\/statemachine\/statestream","navigatorTitle":[{"kind":"identifier","text":"StateStream"}],"type":"topic","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/StateStream","title":"StateMachine.StateStream","abstract":[{"text":"A stream of the states a state machine is at, one after the other.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"StateStream"}]},"doc://MiamiStateMachine/documentation/MiamiStateMachine":{"kind":"symbol","identifier":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine","title":"MiamiStateMachine","url":"\/documentation\/miamistatemachine","abstract":[],"type":"topic","role":"collection"}}}