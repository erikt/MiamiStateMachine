{"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/miamistatemachine\/statemachine\/wait(for:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"wait","kind":"identifier"},{"text":"(","kind":"text"},{"text":"for","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"awaitedState","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"State","kind":"typeIdentifier","preciseIdentifier":"s:17MiamiStateMachine0bC0C0B0q_mfp"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The state to wait for."}],"type":"paragraph"}],"name":"awaitedState"}]},{"content":[{"level":2,"type":"heading","text":"Return Value","anchor":"return-value"},{"inlineContent":[{"type":"text","text":"If the state machine got to the state. It is false if the"},{"type":"text","text":" "},{"type":"text","text":"state machine can no longer get there, or the task was cancelled."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"It returns at once if the state machine is already at the state."},{"type":"text","text":" "},{"type":"text","text":"Otherwise it waits for a transition leading to the state. A state"},{"type":"text","text":" "},{"type":"text","text":"entered and left again before the waiting task runs still counts,"},{"text":" ","type":"text"},{"type":"text","text":"so read "},{"type":"codeVoice","code":"state"},{"type":"text","text":" to know where the state machine is by then."}]},{"type":"paragraph","inlineContent":[{"text":"The waiting ends without the state being reached when the state","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"machine gets to a state from which the state can no longer be reached,"},{"type":"text","text":" "},{"type":"text","text":"like an ending state, and when the task waiting is cancelled."}]},{"inlineContent":[{"text":"Like a stream, it only knows the transitions made after it was","type":"text"},{"text":" ","type":"text"},{"text":"called. A state entered and left again before the call is missed,","type":"text"},{"text":" ","type":"text"},{"text":"which can happen when it is called from a new task, as the task can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"start running after the events were processed. A state the state"},{"text":" ","type":"text"},{"type":"text","text":"machine stays at, like an ending state, is never missed."}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["Task {","    if await stateMachine.wait(for: .delivered) {","        print(\"Delivered\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A task waiting keeps the state machine. For a state machine without"},{"text":" ","type":"text"},{"type":"text","text":"ending states, cancel the task when the state is no longer of interest."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine","doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Waits until the state machine is at a state."}],"identifier":{"url":"doc:\/\/MiamiStateMachine\/documentation\/MiamiStateMachine\/StateMachine\/wait(for:)","interfaceLanguage":"swift"},"metadata":{"conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Event","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code"